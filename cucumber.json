{
  "require": [
    "src/hooks/**/*.ts",
    "tests/e2e/steps/**/*.ts"
  ],
  "requireModule": ["ts-node/register"],
  "format": [
    "progress-bar",
    "html:test-results/cucumber-report.html",
    "json:test-results/cucumber-json/cucumber-report.json",
    "junit:test-results/cucumber-report.xml"
  ],
  "parallel": 1,
  "retry": 0,
  "publishQuiet": true
}
