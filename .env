# ========================================
# Framework Environment Variables
# Copy this file to .env and fill in your values
# ========================================

# Browser & Environment Configuration (Required)
# Set BROWSER=chrome to use system Chrome and avoid SSL certificate errors
# Set PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 to skip downloading browsers
#
# Available Browsers:
#   - chrome: Google Chrome (DEFAULT - avoids SSL cert errors)
#   - edge: Microsoft Edge
#   - firefox, webkit, chromium: Require 'npx playwright install' (not compatible with SKIP_BROWSER_DOWNLOAD)
#
# To switch browsers, set BROWSER env var:
#   PowerShell:  $env:BROWSER = 'edge'; npm run test:bdd:headless
#   CMD:         set BROWSER=edge && npm run test:bdd:headless
#   Linux/Mac:   BROWSER=edge npm run test:bdd:headless
BROWSER=edge
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV=test
HEADLESS=false

# Application URLs (Required)
BASE_URL=https://authentik.sperrydigital-dev.ienergy.halliburton.com/if/flow/hal-local-authentication-flow/
BASE_URL_API=https://api.dev.sperrydigital.ienergy.halliburton.com
APP_URL=https://dev.sperrydigital.ienergy.halliburton.com/logix-alert-management

# Authentication Credentials (Required)
TEST_USERNAME=
TEST_PASSWORD=
USERSINITIALS=

# Optional URLs
LOGIN_URL=
ASSET_TRACKER_URL=

# Optional Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Playwright Browser Information (Auto-populated by Playwright)
# PLAYWRIGHT_BROWSER_NAME=
# PLAYWRIGHT_BROWSER_VERSION=
# PLAYWRIGHT_OS_NAME=
# PLAYWRIGHT_OS_VERSION=

# MCP Server Configuration
# MCP_SERVER_PORT: Port for Custom Auto-Healing MCP Server (default: 4000)
# If port 4000 is in use, the server will automatically find the next available port
# Set this to your preferred port, or leave default for automatic selection
MCP_SERVER_URL=http://localhost
MCP_SERVER_PORT=4000
MCP_HEALTH_CHECK_TIMEOUT=30000
MCP_HEALTH_CHECK_RETRIES=30

# Test Environment Configuration
NODE_ENV=test
CI=false
HEADLESS=false

# Browser Configuration (already set above - keep for reference only)
# BROWSER=chrome (configured at the top)
SLOW_MO=0
TIMEOUT=30000

# Reporting & Logging
LOG_LEVEL=info
REPORT_DIR=./playwright-report
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# Database Configuration (optional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password

# API Configuration (optional)
# API_BASE_URL=https://api.example.com
# API_KEY=your_api_key_here
# API_TIMEOUT=30000

# Righive API Bootstrap (single source of truth)
RIGHIVE_OPTION2_ENABLED=true
RIGHIVE_API_TOKEN=
RIGHIVE_AUTH_TOKEN_ENDPOINT=https://authentik.sperrydigital-dev.ienergy.halliburton.com/application/o/token/
RIGHIVE_AUTH_GRANT_TYPE=client_credentials
RIGHIVE_AUTH_CLIENT_ID=yT5g8XfnCwkrc2uZTpoJmxyU1RA0f6T1vtcgCs0K
RIGHIVE_AUTH_CLIENT_SECRET=8tYQ3906HguENtn2d8vtJqNzathoSgCrjct25SS3mbaniffG2Aziy7MfIpseSAqTPJL0zJMYDoIevqVvMiAyYyihnRh2CSiztZsagxXLnFa0kEUUgQQukWJ4zLV5IySJ
RIGHIVE_AUTH_SCOPE=openid profile
RIGHIVE_AUTH_USERNAME=
RIGHIVE_AUTH_PASSWORD=
RIGHIVE_WELL_ID=NEW12029
RIGHIVE_WELLBORE_ID=NEW12029
RIGHIVE_WELL_NAME=NEW12029
RIGHIVE_TOKEN_CACHE_TTL_HOURS=24
# RIGHIVE_PIN_ENDPOINT and RIGHIVE_PIN_PAYLOAD removed (pin not used)

# Feature Flags
ENABLE_MCP=true
ENABLE_VISUAL_REGRESSION=false
ENABLE_ACCESSIBILITY_TESTS=false

# Parallel Execution
WORKERS=1
MAX_FAILURES=0

# Custom Project Variables
PROJECT_NAME=MAX Command Test Automation
TEST_DATA_PATH=./testdata
FIXTURES_PATH=./src/fixtures
